# Copy to .env and adjust. Never commit real secrets.

# --- AWS credentials resolve via the standard chain (AWS_PROFILE / SSO / env) ---
AWS_REGION=us-east-1
# AWS_PROFILE=my-profile

# --- Bedrock model used by the Strands agent (Amazon Nova only) ---
SCAMSCOPE_MODEL_ID=us.amazon.nova-pro-v1:0

# --- Phase 2: deployed Lambda function name (set after deployment) ---
SCAMSCOPE_LAMBDA_NAME=check_url_reputation

# --- Phase 2: name of the Secrets Manager secret holding the URLhaus Auth-Key ---
# The VALUE lives in Secrets Manager, never here.
SCAMSCOPE_URLHAUS_SECRET_NAME=scamscope/urlhaus-auth-key
